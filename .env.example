# Copy to .env and fill in. Never commit .env.
# Model provider: anthropic (default) or azure_openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# The SEC requires a descriptive User-Agent with a contact email on every request.
SEC_USER_AGENT="Your Name you@example.com"
ANTHROPIC_MODEL=claude-sonnet-5-5

# Azure OpenAI (when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21

# Optional: LangSmith tracing for every agent run
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=edgar-filings-analyst
