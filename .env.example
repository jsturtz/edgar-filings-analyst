# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# The SEC requires a descriptive User-Agent with a contact email on every request.
SEC_USER_AGENT="Your Name you@example.com"
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: LangSmith tracing for every agent run
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=edgar-filings-analyst
